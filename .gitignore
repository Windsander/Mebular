# npm pack 發布期備份（transient）
packages/*/package.json.packbak
*.tgz
# 桌面安裝包 runtime（prepare-runtime 從 release-pack tarball 安裝，不入庫）
/apps/desktop/runtime/
# npm pack 產出的發布 tarball 暫存目錄
/release-pack/

# 示例執行時產物（本地留存）
examples/quickstart/.data/

# 廣域網同步證據（本地留存）
.wan-evidence/

# 語義召回證據與模型快取（本地留存）
.semantic-evidence/
.cache/

# Fleet CLI 預設設備目錄（內含 0600 主密鑰；生產請用 ~/.fleet）
.fleet/

# WAN NAT 仿真临时状态
.wan-nat/

# Python 測試/工具產物
__pycache__/
*.py[cod]
