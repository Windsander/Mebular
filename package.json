{
  "name": "@mebular/core",
  "version": "0.3.0",
  "description": "本地优先的图式记忆系统：为 Hermes 等 Agent 提供跨设备、可离线、可验证的记忆共享层",
  "license": "MIT",
  "author": {
    "name": "Sobert Li (Windsander)",
    "email": "Windsander@users.noreply.github.com",
    "url": "https://github.com/Windsander"
  },
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "mebular": "./packages/mcp/bin/mebular.mjs",
    "fleet": "./packages/fleet/dist/cli.js"
  },
  "files": [
    "dist",
    "locales",
    "packages/mcp/bin",
    "packages/mcp/src",
    "packages/mcp/package.json",
    "packages/console",
    "packages/fleet/dist",
    "packages/fleet/protocol",
    "packages/fleet/package.json",
    "packages/service/dist",
    "packages/service/package.json",
    "packages/skill",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Windsander/Mebular.git"
  },
  "keywords": [
    "local-first",
    "memory",
    "graph",
    "p2p",
    "crdt",
    "vector-clock",
    "ed25519",
    "event-sourcing",
    "hermes",
    "agent"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc && tsc -p packages/service/tsconfig.json && tsc -p packages/fleet/tsconfig.json && node scripts/gen-fleet-version.mjs && node scripts/chmod-bins.mjs",
    "build:fleet": "tsc -p packages/fleet/tsconfig.json",
    "build:service": "tsc -p packages/service/tsconfig.json",
    "prepare": "node scripts/prepare-install.mjs",
    "build:watch": "tsc --watch",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "lint": "eslint src tests tests-semantic scripts packages apps/desktop --ext .ts,.mjs",
    "check:cleanliness": "node scripts/check-cleanliness.mjs",
    "check:surface-parity": "node scripts/check-surface-parity.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "verify:at-rest": "node scripts/scan-at-rest.mjs",
    "verify:semantic": "node scripts/verify-semantic.mjs",
    "verify:semantic:real": "node scripts/verify-semantic.mjs --real",
    "verify:wan": "node scripts/wan-sync.mjs",
    "verify:wan:relay": "node scripts/wan-sync.mjs --relay",
    "verify:wan:cross": "node scripts/wan-sync.mjs cross",
    "verify:wan:cross:selftest": "node scripts/wan-sync.mjs selftest",
    "verify:wan:l2": "node scripts/verify-wan-l2.mjs",
    "verify:wan:l2:docker": "node scripts/verify-wan-l2-docker.mjs",
    "verify:wan:cross:selftest:isolated": "node scripts/wan-sync.mjs selftest-isolated",
    "bench:snapshot": "node scripts/bench-snapshot.mjs",
    "verify:mcp:stdio": "node scripts/verify-mcp-stdio.mjs",
    "verify:mcp:http": "node scripts/verify-mcp-http.mjs",
    "verify:mcp:oauth": "node scripts/verify-mcp-oauth-hardening.mjs",
    "verify:mcp:cross": "node scripts/verify-mcp-cross.mjs",
    "verify:mcp:cross:selftest": "node scripts/verify-mcp-cross.mjs --selftest",
    "verify:mcp:skill": "node scripts/verify-mcp-skill.mjs",
    "verify:mcp:publish": "node scripts/verify-mcp-publish.mjs",
    "verify:dsh-plugin": "node scripts/verify-dsh-plugin.mjs",
    "verify:dsh:e2e": "node scripts/verify-dsh-e2e.mjs",
    "verify:runtime:coexistence": "node scripts/verify-runtime-coexistence.mjs",
    "verify:dsh:e2e:min": "node scripts/verify-dsh-e2e.mjs --dsh-version minimum",
    "verify:dsh:e2e:latest": "node scripts/verify-dsh-e2e.mjs --dsh-version latest",
    "verify:dsh:e2e:negative": "node tests/dsh/e2e/negative-control.mjs",
    "verify:dsh:memory-runtime": "node tests/dsh/e2e/memory-runtime-e2e.mjs",
    "verify:release-version": "node scripts/verify-release-version.mjs",
    "verify:release-visibility": "node scripts/verify-release-visibility.mjs",
    "branches:merged": "node scripts/prune-merged-branches.mjs",
    "verify:fleet:local": "node scripts/verify-fleet-local.mjs",
    "verify:fleet:remote": "node scripts/verify-fleet-remote.mjs",
    "verify:fleet:agents": "node scripts/verify-fleet-agents.mjs",
    "verify:fleet:onboard": "node scripts/verify-fleet-onboard.mjs",
    "verify:star-map:multinode": "node scripts/verify-star-map-multinode.mjs",
    "verify:fleet:tasks": "node scripts/verify-fleet-tasks.mjs",
    "verify:daemon": "node scripts/verify-daemon.mjs",
    "verify:daemon:cluster": "node scripts/verify-daemon-cluster.mjs",
    "verify:convergence": "node scripts/verify-convergence.mjs",
    "verify:console": "node packages/console/scripts/verify-console.mjs",
    "verify:config": "node scripts/verify-config.mjs",
    "verify:onboarding": "node scripts/verify-onboarding.mjs",
    "verify:fleet:service": "node scripts/verify-fleet-service.mjs",
    "verify:fleet:handoff": "node scripts/verify-fleet-handoff.mjs",
    "verify:fleet:collab": "node scripts/verify-fleet-collab.mjs",
    "verify:fleet:all": "node scripts/verify-fleet-all.mjs",
    "verify:security:drill": "node scripts/verify-security-drill.mjs",
    "dev": "node --loader ts-node/esm src/index.ts",
    "verify:connect": "node scripts/verify-connect.mjs",
    "verify:lan": "node scripts/verify-lan.mjs",
    "check:deps": "node scripts/check-deps.mjs",
    "verify:nat": "node scripts/verify-nat.mjs",
    "rulesets:apply": "node scripts/apply-rulesets.mjs --apply",
    "desktop:dev": "npm --prefix apps/desktop run dev",
    "desktop:smoke": "npm --prefix apps/desktop run smoke",
    "verify:console:ui": "node packages/console/scripts/verify-console-ui.mjs",
    "verify:console:subscription-ui": "node packages/console/scripts/verify-subscription-ui.mjs",
    "verify:invite": "node scripts/verify-invite.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.3.1",
    "bonjour": "^3.5.1",
    "qrcode-generator": "2.0.4",
    "ulid": "^3.0.2",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@chainsafe/libp2p-yamux": "^8.0.1",
    "@libp2p/autonat": "3.0.32",
    "@libp2p/circuit-relay-v2": "^4.2.17",
    "@libp2p/crypto": "^5.1.23",
    "@libp2p/dcutr": "3.0.32",
    "@libp2p/identify": "^4.1.18",
    "@libp2p/peer-id": "^6.0.15",
    "@libp2p/tcp": "^11.0.32",
    "@multiformats/multiaddr": "^13.0.3",
    "libp2p": "^3.5.1"
  },
  "peerDependencies": {
    "@huggingface/transformers": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@modelcontextprotocol/server": "^2.3.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.24",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "eslint": "^8.57.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@deepseek-ai/dsh-http-proxy": {
      "undici": "8.12.3"
    },
    "@deepseek-ai/dsh-llm": {
      "zod": "4.6.7"
    },
    "@deepseek-ai/dsh-mcp-client": {
      "@modelcontextprotocol/client": "2.4.0"
    },
    "@deepseek-ai/dsh-sandbox-policy": {
      "zod": "4.6.7"
    },
    "@deepseek-ai/dsh-session-projection": {
      "zod": "4.6.7"
    }
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "mjs",
      "json",
      "node"
    ],
    "moduleNameMapper": {
      "^(\\.\\./)+service/dist/index\\.js$": "<rootDir>/packages/service/src/index.ts",
      "^(\\.\\./)+fleet/dist/index\\.js$": "<rootDir>/packages/fleet/src/index.ts",
      "^src/(.*)\\.js$": "<rootDir>/src/$1.ts",
      "^tests/(.*)\\.js$": "<rootDir>/tests/$1.ts",
      "^@mebular/core$": "<rootDir>/src/index.ts",
      "^@mebular/service$": "<rootDir>/packages/service/src/index.ts",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "testMatch": [
      "**/tests/**/*.test.ts",
      "**/tests/**/*.test.mjs"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "packages/fleet/src/**/*.ts",
      "!packages/fleet/src/**/*.d.ts",
      "packages/service/src/**/*.ts",
      "!packages/service/src/**/*.d.ts"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "src/p2p/transport/Libp2pProvider.ts",
      "packages/fleet/src/cli.ts"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 85,
        "branches": 65
      },
      "src/p2p/connection/ConnectionManager.ts": {
        "lines": 85,
        "branches": 60
      },
      "src/p2p/connection/EndpointBook.ts": {
        "lines": 85,
        "branches": 65
      },
      "src/p2p/P2PNetwork.ts": {
        "lines": 80,
        "branches": 65
      },
      "src/sync/netEndpoints.ts": {
        "lines": 85,
        "branches": 70
      },
      "src/p2p/handshake/AuthenticationHandshake.ts": {
        "lines": 90,
        "branches": 85
      },
      "src/storage/MemoryStorage.ts": {
        "lines": 80,
        "branches": 60
      },
      "src/sync/apply.ts": {
        "lines": 95,
        "branches": 70
      },
      "packages/fleet/src/**/*.ts": {
        "lines": 85,
        "branches": 65
      },
      "packages/service/src/**/*.ts": {
        "lines": 85,
        "branches": 65
      }
    }
  }
}
