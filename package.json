{
  "name": "mebular",
  "version": "0.1.0",
  "private": true,
  "description": "本地优先的图式记忆系统：为 Hermes 等 Agent 提供跨设备、可离线、可验证的记忆共享层",
  "license": "MIT",
  "author": "Windsander",
  "repository": {
    "type": "git",
    "url": "https://github.com/Windsander/Mebular.git"
  },
  "keywords": [
    "local-first",
    "memory",
    "graph",
    "p2p",
    "crdt",
    "vector-clock",
    "ed25519",
    "event-sourcing",
    "hermes",
    "agent"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "lint": "eslint src tests scripts --ext .ts,.mjs",
    "verify": "node scripts/verify-phase5.mjs",
    "dev": "node --loader ts-node/esm src/index.ts"
  },
  "dependencies": {
    "bonjour": "^3.5.1",
    "ulid": "^2.3.0"
  },
  "optionalDependencies": {
    "@chainsafe/libp2p-noise": "^17.0.0",
    "@chainsafe/libp2p-yamux": "^8.0.1",
    "@libp2p/crypto": "^5.1.23",
    "@libp2p/peer-id": "^6.0.15",
    "@libp2p/tcp": "^11.0.27",
    "@multiformats/multiaddr": "^13.0.3",
    "libp2p": "^3.3.9"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.24",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "moduleNameMapper": {
      "^src/(.*)\\.js$": "<rootDir>/src/$1.ts",
      "^tests/(.*)\\.js$": "<rootDir>/tests/$1.ts",
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts"
    ]
  }
}
