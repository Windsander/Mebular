{
  "name": "@mebular/dsh-plugin",
  "version": "0.1.0",
  "description": "Mebular memory and task graph for DeepSeek Harness",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client/index.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "client",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "mebular",
    "mcp",
    "agent-memory"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Windsander/Mebular.git",
    "directory": "packages/dsh-plugin"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
