{
  "name": "@mebular/dsh-plugin",
  "version": "0.1.2",
  "description": "Mebular memory, task graph, and shared Console for DeepSeek Harness",
  "license": "MIT",
  "author": "Windsander",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*": "./locale/*"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale",
    "README.md",
    "LICENSE",
    "icon.svg",
    "screenshots.json",
    "assets"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "mebular",
    "mcp",
    "agent-memory",
    "console"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Windsander/Mebular.git",
    "directory": "packages/dsh-plugin"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-mcp-client": ">=0.2.1-rc.2 <0.2.2-0 || >=0.2.2-rc.1 <0.3.0-0"
  }
}
