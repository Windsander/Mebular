{
  "name": "@mebular/fleet",
  "version": "0.1.0",
  "description": "Mebular 跨设备多 Agent 协作（任务=记忆）：task-as-memory 的派发与回收，无中心协调",
  "license": "MIT",
  "private": false,
  "type": "module",
  "bin": {
    "fleet": "./dist/cli.js"
