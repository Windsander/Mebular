    }
  },
  "files": [
    "src",
    "dist",
    "protocol"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@mebular/core": "file:../.."
  }
}
