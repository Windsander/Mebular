{
  "v": 1,
  "note": "Fleet 黑盒编排 plan 节点夹具 v1。task_plan 是 internal 记忆节点，不进入人类 UI 或 fleet SSE；唯一创建路径是 task_submit 的 optional plan 字段（完整 plan 定义），Fleet 校验后创建 plan 节点与 root task。taskId 规则：step=${planId}#${version}#${stepId}，root=${planId}#${version}#root；planId/stepId 不得含 #，stepId 不得为 root。root task 的 target 固定为保留 sentinel {device:'__plan__',agent:'__plan__'}，旧/新 worker 都必须跳过。",
  "internalWrapper": {
    "note": "writer 负责把逻辑 plan 记录包装为 internal 记忆节点；以下为最小 metadata 示例，不规定 node type",
    "metadata": {
      "internal": true,
      "internalObject": { "kind": "task_plan" }
    }
  },
  "submission": {
    "tool": "task_submit",
    "arguments": {
      "intent": "提交一个完整 plan",
      "to": { "device": "__plan__", "agent": "__plan__" },
      "plan": {
        "v": 1,
        "kind": "task_plan",
        "planId": "plan-submit-001",
        "version": 1,
        "owner": { "device": "device-A", "agent": "planner" },
        "goal": "最小可提交 plan：work → pre-MR gate → MR",
        "createdAt": 1700000006000,
        "budget": { "maxSteps": 3, "maxAttemptsPerStep": 1 },
        "policy": {
          "allowedDevices": ["device-B"],
          "allowedAgents": ["worker"],
          "requireCapabilities": ["fleet.task"],
          "maxParallel": 1,
          "allowSubcontract": false
        },
        "steps": [
          { "stepId": "work", "kind": "task", "intent": "执行唯一工作 step", "dependsOn": [], "acceptance": { "kind": "non-empty-result" } },
          { "stepId": "pre-mr", "kind": "reduce", "intent": "pre-MR gate", "dependsOn": ["work"], "join": { "mode": "all" }, "acceptance": { "kind": "non-empty-result" } },
          { "stepId": "mr", "kind": "mr", "intent": "提交唯一 MR", "dependsOn": ["pre-mr"], "acceptance": { "kind": "mr-once" } }
        ]
      }
    },
    "expect": {
      "ok": true,
      "planId": "plan-submit-001",
      "version": 1,
      "rootTaskId": "plan-submit-001#1#root",
      "taskId": "plan-submit-001#1#root",
      "rootTarget": { "device": "__plan__", "agent": "__plan__" }
    }
  },
  "idempotency": {
    "repeatSame": {
      "tool": "task_submit",
      "arguments": {
        "intent": "提交一个完整 plan",
        "to": { "device": "__plan__", "agent": "__plan__" },
        "plan": {
          "v": 1,
          "kind": "task_plan",
          "planId": "plan-submit-001",
          "version": 1,
          "owner": { "device": "device-A", "agent": "planner" },
          "goal": "最小可提交 plan：work → pre-MR gate → MR",
          "createdAt": 1700000006001,
          "budget": { "maxSteps": 3, "maxAttemptsPerStep": 1 },
          "policy": {
            "allowedDevices": ["device-B"],
            "allowedAgents": ["worker"],
            "requireCapabilities": ["fleet.task"],
            "maxParallel": 1,
            "allowSubcontract": false
          },
          "steps": [
            { "stepId": "work", "kind": "task", "intent": "执行唯一工作 step", "dependsOn": [], "acceptance": { "kind": "non-empty-result" } },
            { "stepId": "pre-mr", "kind": "reduce", "intent": "pre-MR gate", "dependsOn": ["work"], "join": { "mode": "all" }, "acceptance": { "kind": "non-empty-result" } },
            { "stepId": "mr", "kind": "mr", "intent": "提交唯一 MR", "dependsOn": ["pre-mr"], "acceptance": { "kind": "mr-once" } }
          ]
        }
      },
      "expect": { "ok": true, "planId": "plan-submit-001", "version": 1, "rootTaskId": "plan-submit-001#1#root", "deduped": true }
    },
    "conflict": {
      "tool": "task_submit",
      "arguments": {
        "intent": "冲突提交",
        "to": { "device": "__plan__", "agent": "__plan__" },
        "plan": {
          "v": 1,
          "kind": "task_plan",
          "planId": "plan-submit-001",
          "version": 1,
          "owner": { "device": "device-A", "agent": "planner" },
          "goal": "同 planId+version 但内容不同",
          "createdAt": 1700000006002,
          "budget": { "maxSteps": 3, "maxAttemptsPerStep": 1 },
          "policy": {
            "allowedDevices": ["device-B"],
            "allowedAgents": ["worker"],
            "requireCapabilities": ["fleet.task"],
            "maxParallel": 1,
            "allowSubcontract": false
          },
          "steps": [
            { "stepId": "work", "kind": "task", "intent": "执行唯一工作 step", "dependsOn": [], "acceptance": { "kind": "non-empty-result" } },
            { "stepId": "pre-mr", "kind": "reduce", "intent": "pre-MR gate", "dependsOn": ["work"], "join": { "mode": "all" }, "acceptance": { "kind": "non-empty-result" } },
            { "stepId": "mr", "kind": "mr", "intent": "提交唯一 MR", "dependsOn": ["pre-mr"], "acceptance": { "kind": "mr-once" } }
          ]
        }
      },
      "expect": { "ok": false, "error": "PLAN_CONFLICT", "created": [] }
    }
  },
  "controls": {
    "retryRoot": {
      "tool": "task_retry",
      "arguments": { "taskId": "plan-submit-001#1#root" },
      "expect": { "ok": false, "error": "PLAN_RETRY_REQUIRED", "taskId": "plan-submit-001#1#root" }
    },
    "retryStep": {
      "tool": "task_retry",
      "arguments": { "taskId": "plan-submit-001#1#work" },
      "expect": { "ok": false, "error": "PLAN_RETRY_REQUIRED", "taskId": "plan-submit-001#1#work" }
    },
    "retryMr": {
      "tool": "task_retry",
      "arguments": { "taskId": "plan-submit-001#1#mr" },
      "expect": { "ok": false, "error": "PLAN_RETRY_REQUIRED", "taskId": "plan-submit-001#1#mr" }
    },
    "cancelPlan": {
      "tool": "task_cancel",
      "arguments": { "taskId": "plan-submit-001#1#root" },
      "expect": { "ok": true, "taskId": "plan-submit-001#1#root", "status": "failed", "reason": "CANCELLED" },
      "note": "plan 级取消；级联取消该 version 全部非终态 step task 及 sub-plan 派生树；已提交 MR 不撤销"
    },
    "cancelTerminalRoot": {
      "tool": "task_cancel",
      "arguments": { "taskId": "plan-submit-001#1#root" },
      "expect": { "ok": false, "taskId": "plan-submit-001#1#root", "reason": "already-terminal" },
      "note": "root task 已终态时不再级联，与普通 task_cancel 一致"
    }
  },
  "plan": {
    "v": 1,
    "kind": "task_plan",
    "planId": "plan-demo-001",
    "version": 1,
    "owner": { "device": "device-A", "agent": "planner" },
    "goal": "三台设备并行完成实现与审查，经 pre-MR gate 后只提交一次 MR",
    "createdAt": 1700000000000,
    "budget": { "maxSteps": 8, "maxAttemptsPerStep": 2 },
    "policy": {
      "allowedDevices": ["device-B", "device-C", "device-D"],
      "allowedAgents": ["worker", "reviewer"],
      "requireCapabilities": ["fleet.task"],
      "maxParallel": 3,
      "allowSubcontract": false
    },
    "steps": [
      {
        "stepId": "collect",
        "kind": "task",
        "intent": "收集需求与约束",
        "dependsOn": [],
        "to": { "device": "device-B", "agent": "worker" },
        "route": { "require": ["research"], "prefer": ["fast"], "strategy": "deterministic" },
        "acceptance": { "kind": "non-empty-result", "minBytes": 1 }
      },
      {
        "stepId": "build-api",
        "kind": "task",
        "intent": "实现 API",
        "dependsOn": ["collect"],
        "route": { "require": ["code.write", "api"], "prefer": ["low-latency"], "strategy": "deterministic" },
        "acceptance": { "kind": "contains", "all": ["API_OK"] }
      },
      {
        "stepId": "build-ui",
        "kind": "task",
        "intent": "实现 UI",
        "dependsOn": ["collect"],
        "route": { "require": ["code.write", "ui"], "prefer": [], "strategy": "deterministic" },
        "acceptance": { "kind": "contains", "all": ["UI_OK"] }
      },
      {
        "stepId": "join",
        "kind": "join",
        "intent": "等待两个实现分支并汇合结果",
        "dependsOn": ["build-api", "build-ui"],
        "join": { "mode": "all" },
        "acceptance": { "kind": "non-empty-result" }
      },
      {
        "stepId": "pre-mr",
        "kind": "reduce",
        "intent": "pre-MR gate：校验分支验收并组装 MR 载荷",
        "dependsOn": ["join"],
        "join": { "mode": "all" },
        "acceptance": { "kind": "contains", "all": ["GATE_OK"] }
      },
      {
        "stepId": "mr",
        "kind": "mr",
        "intent": "提交本 plan 唯一一次 MR",
        "dependsOn": ["pre-mr"],
        "to": { "device": "device-B", "agent": "reviewer" },
        "acceptance": { "kind": "mr-once" }
      }
    ]
  },
  "retry": {
    "v": 1,
    "kind": "task_plan",
    "planId": "plan-demo-001",
    "version": 2,
    "supersedesVersion": 1,
    "retryOfStepId": "build-ui",
    "reason": "build-ui 分支失败；保留已完成的 collect/build-api，重建下游 join 与 MR",
    "owner": { "device": "device-A", "agent": "planner" },
    "goal": "三台设备并行完成实现与审查，经 pre-MR gate 后只提交一次 MR",
    "createdAt": 1700000001000,
    "budget": { "maxSteps": 8, "maxAttemptsPerStep": 2 },
    "policy": {
      "allowedDevices": ["device-B", "device-C", "device-D"],
      "allowedAgents": ["worker", "reviewer"],
      "requireCapabilities": ["fleet.task"],
