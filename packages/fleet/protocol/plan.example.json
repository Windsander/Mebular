      ]
    },
    "parentStepTaskBudget": {
      "note": "runtime TaskBudget，非 plan 字段；父 step task 的既有预算必须容纳 child root/step task",
      "maxDepth": 3,
      "maxChildren": 8,
      "maxTasks": 12
    },
    "submission": {
      "caller": { "device": "device-B", "agent": "worker" },
      "tool": "task_submit",
      "arguments": {
        "intent": "由 B 提交子 plan",
        "to": { "device": "__plan__", "agent": "__plan__" },
        "plan": {
          "v": 1,
          "kind": "task_plan",
          "planId": "plan-demo-002-child",
          "version": 1,
          "parent": { "planId": "plan-demo-002", "version": 1, "stepId": "delegate" },
          "owner": { "device": "device-B", "agent": "worker" },
          "goal": "子 plan：由 B 提交；policy 收紧，且不提交 MR",
          "createdAt": 1700000005000,
          "budget": { "maxSteps": 4, "maxAttemptsPerStep": 1 },
          "policy": {
            "allowedDevices": ["device-B"],
            "allowedAgents": ["worker"],
            "requireCapabilities": ["fleet.task", "code.write"],
            "maxParallel": 1,
            "allowSubcontract": false
          },
          "steps": [
            { "stepId": "work", "kind": "task", "intent": "子 plan 唯一执行 step", "dependsOn": [], "acceptance": { "kind": "non-empty-result" } }
          ]
        }
      },
      "expect": {
        "ok": true,
        "planId": "plan-demo-002-child",
        "version": 1,
        "rootTaskId": "plan-demo-002-child#1#root",
        "owner": { "device": "device-B", "agent": "worker" }
      }
    }
  },
  "joinModes": [
    { "mode": "all" },
    { "mode": "any" },
    { "mode": "quorum", "quorum": 2 }
  ],
