{
  "name": "@mebular/mcp",
  "version": "0.3.0",
  "description": "Mebular MCP server（stdio + Streamable HTTP）：把 Mebular 记忆能力暴露给任意 MCP client",
  "license": "MIT",
  "author": {
    "name": "Sobert Li (Windsander)",
    "email": "Windsander@users.noreply.github.com",
    "url": "https://github.com/Windsander"
  },
  "private": false,
  "type": "module",
  "bin": {
    "mebular": "./bin/mebular.mjs"
  },
  "files": [
    "bin",
    "src",
    "scripts"
  ],
  "scripts": {
    "prepack": "node ../../scripts/publish-manifest.mjs set",
    "postpack": "node ../../scripts/publish-manifest.mjs restore"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@mebular/core": "file:../..",
    "@mebular/memory-runtime": "file:../memory-runtime",
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.7",
    "@mebular/fleet": "file:../fleet"
  }
}
