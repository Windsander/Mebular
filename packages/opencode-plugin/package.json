{
  "name": "@mebular/opencode-plugin",
  "version": "0.3.2",
  "description": "Opt-in OpenCode V2 server plugin for Mebular Memory Runtime (OpenChamber). | 面向 Mebular Memory Runtime 的 OpenCode V2 可选服务端插件（OpenChamber）。",
  "license": "MIT",
  "author": {
    "name": "Sobert Li (Windsander)",
    "email": "Windsander@users.noreply.github.com",
    "url": "https://github.com/Windsander"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./fleet-runner": "./fleet-runner.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "fleet-runner.js",
    "README.md",
    "LICENSE"
  ],
