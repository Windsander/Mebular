{
  "name": "@mebular/service",
  "version": "0.2.3",
  "description": "Mebular 常驻组件服务化：平台单元生成（launchd/systemd/Task Scheduler）+ install/uninstall/status/logs + 进程心跳",
  "license": "MIT",
  "author": {
    "name": "Sobert Li (Windsander)",
    "email": "Windsander@users.noreply.github.com",
    "url": "https://github.com/Windsander"
  },
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepack": "node ../../scripts/publish-manifest.mjs set",
    "postpack": "node ../../scripts/publish-manifest.mjs restore"
  }
}
